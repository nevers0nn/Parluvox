{
  "name": "@parluvox/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Parluvox HR interview co-pilot — desktop shell",
  "author": "Parluvox",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-vendor.mjs",
    "start": "electron .",
    "dev": "tsc -p tsconfig.json && electron .",
    "package": "electron-builder --win portable"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.parluvox.desktop",
    "productName": "Parluvox",
    "asar": false,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "vendor/**/*", "package.json"],
    "win": { "target": ["portable"] },
    "portable": { "artifactName": "Parluvox-${version}-portable.${ext}" }
  }
}
