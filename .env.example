# --- LLM provider (required, no default on purpose) ---
# One of: openai | anthropic
LLM_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Speech-to-text ---
DEEPGRAM_API_KEY=
# nova-3 required for language=multi to include Russian (nova-2's multi mode is ES+EN only)
DEEPGRAM_MODEL=nova-3

# --- Server ---
PORT=8787
DATA_DIR=./data

# HTTP proxy for outbound LLM calls (OpenAI/Anthropic), e.g. when a provider
# geo-blocks your IP. Node's fetch does NOT read HTTP_PROXY/HTTPS_PROXY on
# its own, unlike curl, so this needs to be set explicitly.
# Hiddify's local mixed proxy is typically http://127.0.0.1:12334 — check
# your client's local proxy port. Leave empty to call providers directly.
# Does not affect Deepgram (WebSocket-based STT is not proxied).
PROXY_URL=
